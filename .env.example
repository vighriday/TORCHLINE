# Copy only if .env does not already exist. `pnpm db:up` creates private local DB configuration.
WORLD_MODE=simulation
PUBLIC_BASE_URL=http://localhost:3000
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:54329/torchline
SESSION_SECRET=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
TOKEN_ENCRYPTION_KEY=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
BOT_SETUP_SECRET=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:3000/auth/twitch/callback
TWITCH_BOT_USER_ID=
EVENTSUB_SECRET=
# Optional development HTTPS tunnel; never needed by the deployed application.
NGROK_AUTHTOKEN=
# Operational admission defaults; not engine rewards or supported-capacity claims.
INPUT_VIEWER_BURST=6
INPUT_VIEWER_PER_SECOND=1
INPUT_WORLD_BURST=60
INPUT_WORLD_PER_SECOND=30
INPUT_MAX_PENDING=128
FEED_MAX_PER_CHANNEL=8
FEED_MAX_TOTAL=256
# Pause outbound replies independently; incoming Twitch gameplay stays enabled.
BOT_REPLIES_ENABLED=true
# Optional pinned mission extension. Existing Ark play works with this disabled.
LIVEWIRE_ENABLED=false
DB_STATEMENT_TIMEOUT_MS=10000
DB_LOCK_TIMEOUT_MS=2000
DB_IDLE_TRANSACTION_TIMEOUT_MS=15000

# Independent backup key; generated locally by backup:prepare. Preserve separately.
BACKUP_ENCRYPTION_KEY=
