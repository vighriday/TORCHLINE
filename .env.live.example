# Your own live TORCHLINE for compose.live.yaml. Copy to .env.live (ignored by Git and never
# copied into the Docker image), fill every value, then follow README → Judge guide → path 4.

# Free ngrok account: dashboard.ngrok.com → Your Authtoken, and Domains → your dev domain.
NGROK_AUTHTOKEN=REPLACE_WITH_YOUR_NGROK_AUTHTOKEN
# Your ngrok dev domain as an HTTPS origin, with no trailing slash.
PUBLIC_BASE_URL=https://your-name.ngrok-free.dev

# Your Twitch application: dev.twitch.tv/console/apps. Its OAuth Redirect URL must be
# PUBLIC_BASE_URL followed by /auth/twitch/callback.
TWITCH_CLIENT_ID=REPLACE_WITH_YOUR_TWITCH_CLIENT_ID
TWITCH_CLIENT_SECRET=REPLACE_WITH_YOUR_TWITCH_CLIENT_SECRET

# Four independent private keys, 64 hexadecimal characters each. The README prints a fresh set
# with one Docker command. BOT_SETUP_SECRET is what you type when authorizing your bot account.
SESSION_SECRET=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
TOKEN_ENCRYPTION_KEY=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
BOT_SETUP_SECRET=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
EVENTSUB_SECRET=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
