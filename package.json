{
  "name": "torchline",
  "private": true,
  "version": "0.1.0-preview.4",
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env apps/server/src/main.ts",
    "dev:web": "pnpm --filter @torchline/web dev",
    "start": "node --env-file-if-exists=.env apps/server/src/main.ts",
    "build": "pnpm typecheck && pnpm --filter @torchline/web build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "audit:legacy": "node scripts/audit-legacy.mjs",
    "audit:balance": "node scripts/analyze-balance.ts",
    "design:fixtures": "node scripts/export-design-fixtures.ts",
    "readme:proof": "node scripts/readme/export-proof.ts",
    "check:repo": "node scripts/check-repo.mjs",
    "check:version": "node scripts/check-version.mjs",
    "check:public-secrets": "node scripts/check-public-secrets.ts",
    "format": "prettier --write apps packages scripts tests package.json tsconfig.json vitest.config.ts playwright.config.ts .github/workflows/verify.yml",
    "format:check": "prettier --check apps packages scripts tests package.json tsconfig.json vitest.config.ts playwright.config.ts .github/workflows/verify.yml",
    "db:up": "node scripts/local-db.mjs up",
    "db:down": "node scripts/local-db.mjs down",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.ts",
    "twitch:doctor": "node --env-file-if-exists=.env scripts/twitch-doctor.ts",
    "live:prepare": "node --env-file-if-exists=.env scripts/prepare-live.ts",
    "db:migrate:live": "node --env-file=.env.live scripts/migrate.ts",
    "start:live": "node --env-file=.env.live apps/server/src/main.ts",
    "live:tunnel": "node --env-file=.env.live scripts/tunnel-live.ts",
    "live:origin": "node scripts/set-live-origin.ts",
    "live:ssh:prepare": "node scripts/tunnel-ssh.ts --prepare",
    "live:ssh": "node --env-file=.env.live scripts/tunnel-ssh.ts",
    "live:acceptance": "node --env-file=.env.live scripts/live-acceptance.ts",
    "live:up": "node --env-file=.env.live scripts/live-session.ts up",
    "live:check": "node --env-file=.env.live scripts/live-session.ts check",
    "twitch:verify:overlay": "node --env-file=.env.live scripts/verify-overlay.ts",
    "twitch:verify:play": "node --env-file=.env.live scripts/verify-live-play.ts",
    "twitch:verify:obs": "node scripts/verify-obs.ts",
    "backup:prepare": "node scripts/backup.ts prepare",
    "backup:create": "node --env-file=.env.live scripts/backup.ts create",
    "backup:drill": "node --env-file=.env.live scripts/backup.ts drill",
    "backup:restore": "node --env-file=.env.live scripts/backup.ts restore",
    "twitch:doctor:live": "node --env-file=.env.live scripts/twitch-doctor.ts",
    "twitch:verify:live": "node --env-file=.env.live scripts/verify-live.ts",
    "twitch:verify:livewire": "node --env-file=.env.live scripts/verify-livewire.ts"
  },
  "dependencies": {
    "@torchline/contracts": "workspace:*",
    "@torchline/engine": "workspace:*",
    "@torchline/storage": "workspace:*",
    "@torchline/twitch": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.1",
    "@types/pg": "8.15.6",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
